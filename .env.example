# PostgreSQL 运行时地址。Neon/Vercel 使用带 -pooler 的地址；本地和 Docker 使用直连地址。
# 生产环境请使用强密码，不要提交真实值，也不要把自托管数据库端口暴露到公网。
DATABASE_URL="postgresql://postgres:replace-with-a-strong-password@localhost:5432/personal_knowledge_agent"

# 可选：Neon/Vercel 部署时填 Neon 非 pooled 直连地址，只供 Prisma CLI migration 使用。
# 本地 PostgreSQL 和 Docker 不需要配置；不要把真实地址或密码提交到 Git。
# DIRECT_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth 用它签名登录 Cookie。请换成足够长的随机字符串。
AUTH_SECRET="replace-with-a-long-random-secret"

# 在 https://platform.deepseek.com/ 创建；不要添加 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY="sk-your-deepseek-key"

# Flash 成本低、速度快；需要更强推理时可换成 deepseek-v4-pro。
DEEPSEEK_MODEL="deepseek-v4-flash"

# 可选：按 UTC 自然日限制已通过认证的聊天请求。无效值会回退到 20/60，不能用 0 关闭。
CHAT_DAILY_USER_LIMIT=20
CHAT_DAILY_GLOBAL_LIMIT=60
