# SQLite 数据库文件。开发环境会在项目根目录使用 dev.db。
DATABASE_URL="file:./dev.db"

# NextAuth 用它签名登录 Cookie。请换成足够长的随机字符串。
AUTH_SECRET="replace-with-a-long-random-secret"

# 在 https://platform.deepseek.com/ 创建；不要添加 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY="sk-your-deepseek-key"

# Flash 成本低、速度快；需要更强推理时可换成 deepseek-v4-pro。
DEEPSEEK_MODEL="deepseek-v4-flash"
