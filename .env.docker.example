# 复制为 .env.docker 后再启动 Compose。密码请使用 URL 安全字符，避免破坏 DATABASE_URL。
POSTGRES_DB=personal_knowledge_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

# NextAuth 用于签名登录 Cookie，生产环境请使用高熵随机值。
AUTH_SECRET=replace-with-a-long-random-secret

# 聊天功能需要；只验证数据库和健康检查时可以暂时留空。
# 默认启动不会导入 demo seed；确有需要时按 README 的一次性命令显式执行。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 按 UTC 自然日限制每用户与全站的聊天请求，防止公开演示站被持续消耗余额。
CHAT_DAILY_USER_LIMIT=20
CHAT_DAILY_GLOBAL_LIMIT=60

# 宿主机访问端口，容器内固定监听 3000。
APP_PORT=3000
